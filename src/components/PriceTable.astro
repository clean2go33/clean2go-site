---
import { categories, formules, supplements, hasPrices } from '@/data/tarifs';
import { SITE } from '@/config/site';
import Button from './Button.astro';
const eur = (n: number) => `${n.toLocaleString('fr-FR')} €`;
const priced = hasPrices();
const extraPrice = (p: number | string | null) => (p === null ? null : typeof p === 'number' ? eur(p) : p);
---
{priced ? (
  <>
    <table class="ptable">
      <thead><tr><th scope="col">Formule</th>{categories.map((c) => <th scope="col">{c.label}</th>)}</tr></thead>
      <tbody>
        {formules.map((f) => (
          <tr>
            <th scope="row"><a href={f.href} style="text-decoration:none">{f.name}</a><small>{f.summary}</small></th>
            {categories.map((c) => <td data-l={c.label}>{f.price[c.id] != null ? eur(f.price[c.id] as number) : <>Sur devis</>}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    {categories.some((c) => c.examples) && <p class="form__note" style="margin-top:14px">{categories.map((c) => `${c.label} : ${c.examples}`).join(' · ')}</p>}
  </>
) : (
  <div class="grid grid--3">
    {formules.map((f) => (
      <a class="card" href={f.href}>
        <h3>{f.name}</h3><p>{f.summary}</p>
        {SITE.tarifsFallback === 'devis'
          ? <p><strong>Tarif communiqué sur devis</strong>, selon le véhicule et son état.</p>
          : <p><span class="confirm" data-confirm={`Tarifs « ${f.name} » par catégorie de véhicule`}>[INFORMATION À CONFIRMER]</span></p>}
        <span class="textlink">Voir la prestation</span>
      </a>
    ))}
  </div>
)}
<h3 style="margin-top:2.2em">Suppléments éventuels</h3>
<p class="form__note" style="margin-bottom:16px">Appliqués uniquement lorsque l’état du véhicule le justifie, et annoncés dans le devis avant l’intervention.</p>
<div class="grid grid--3">
  {supplements.map((s) => (
    <div class="card"><h3>{s.name}</h3><p>{s.summary}</p><p><strong>{extraPrice(s.price) ?? (SITE.tarifsFallback === 'devis' ? 'Précisé dans le devis' : '')}</strong>{extraPrice(s.price) === null && SITE.tarifsFallback !== 'devis' && <span class="confirm" data-confirm={`Tarif du supplément « ${s.name} »`}>[INFORMATION À CONFIRMER]</span>}</p></div>
  ))}
</div>
<div class="btns"><Button href="/contact/#devis">Obtenir mon devis</Button></div>
