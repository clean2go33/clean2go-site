---
/**
 * Scène d'accueil : l'utilitaire Clean2Go arrive en glissant et se gare à côté du message.
 * 100 % CSS/SVG (aucune librairie). Déclenchée à l'entrée dans l'écran (site.ts, [data-scene]).
 * Sans JS ou avec « réduire les animations » : état final affiché directement.
 * Illustration originale, non photographique : ne pas la présenter comme un véhicule réel de l'entreprise.
 */
import Button from './Button.astro';
---
<section class="scene" data-scene aria-labelledby="scene-title">
  <div class="wrap scene__in">
    <div class="scene__txt">
      <span class="eyebrow">Nettoyage mobile</span>
      <h2 id="scene-title" class="scene__title"><span class="w w1">On vient</span> <span class="w w2">à vous<em>.</em></span></h2>
      <p class="scene__lead">Votre véhicule n’a pas à bouger : nous arrivons avec le matériel vapeur, chez vous ou sur votre lieu de travail.</p>
      <ul class="scene__chips"><li>Bordeaux Métropole</li><li>Bassin d’Arcachon</li></ul>
      <div class="btns scene__cta"><Button href="/contact/#reservation">Réserver</Button><Button href="/zones-d-intervention/" variant="light" arrow={false}>Voir les zones</Button></div>
    </div>

    <div class="scene__stage" aria-hidden="true">
      <svg class="wisps" viewBox="0 0 240 150" focusable="false">
        <path class="wisp wisp1" d="M60 150c26-34-24-52 4-84s-14-44 8-66"/>
        <path class="wisp wisp2" d="M120 150c26-40-24-60 4-96s-14-40 8-54"/>
        <path class="wisp wisp3" d="M180 150c20-30-18-46 4-74"/>
      </svg>
      <div class="van">
        <svg viewBox="0 0 530 205" focusable="false" role="img" aria-label="Utilitaire Clean2Go">
          <defs>
            <clipPath id="vbody"><path d="M24 160V58Q24 40 42 40H352Q368 40 376 51L438 101Q454 105 486 113Q510 119 510 142V160Z"/></clipPath>
            <linearGradient id="vsheen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#E3E8EC"/></linearGradient>
          </defs>
          <ellipse cx="268" cy="196" rx="236" ry="7" fill="#000" opacity=".35"/>
          <path d="M24 160V58Q24 40 42 40H352Q368 40 376 51L438 101Q454 105 486 113Q510 119 510 142V160Z" fill="url(#vsheen)"/>
          <g clip-path="url(#vbody)">
            <rect x="0" y="142" width="530" height="9" fill="#E8453F"/>
            <rect x="0" y="151" width="530" height="12" fill="#0F1317" opacity=".85"/>
            <path d="M372 44V160" stroke="#0F1317" stroke-opacity=".18" stroke-width="2"/>
            <path d="M24 60H372" stroke="#0F1317" stroke-opacity=".05" stroke-width="1"/>
          </g>
          <path d="M382 58L430 100H382Z" fill="#26323D"/>
          <path d="M388 66L418 92H388Z" fill="#fff" opacity=".12"/>
          <rect x="384" y="118" width="22" height="5" rx="2.5" fill="#0F1317" opacity=".35"/>
          <image href="/logo.png" x="92" y="48" width="205" height="85" />
          <rect x="22" y="118" width="6" height="16" rx="2" fill="#E8453F"/>
          <path d="M504 124h8q2 0 2 3v10q0 3-3 3h-7z" fill="#FFE9A8"/>
          <rect x="494" y="152" width="22" height="10" rx="3" fill="#C9D0D6"/>
          <g class="wheel"><circle cx="110" cy="162" r="38" fill="#0F1317"/><g class="spin"><circle cx="110" cy="162" r="30" fill="#161C22"/><circle cx="110" cy="162" r="17" fill="#C9D0D6"/><path d="M110 148v28M96 162h28M100 152l20 20M120 152l-20 20" stroke="#8E99A3" stroke-width="2"/><circle cx="110" cy="162" r="5" fill="#59636C"/></g></g>
          <g class="wheel"><circle cx="420" cy="162" r="38" fill="#0F1317"/><g class="spin"><circle cx="420" cy="162" r="30" fill="#161C22"/><circle cx="420" cy="162" r="17" fill="#C9D0D6"/><path d="M420 148v28M406 162h28M410 152l20 20M430 152l-20 20" stroke="#8E99A3" stroke-width="2"/><circle cx="420" cy="162" r="5" fill="#59636C"/></g></g>
        </svg>
        <i class="smoke smoke--a"></i><i class="smoke smoke--b"></i><i class="smoke smoke--c"></i><i class="smoke smoke--d"></i>
      </div>
    </div>
  </div>
  <div class="road" aria-hidden="true"><i class="skid"></i></div>
</section>
