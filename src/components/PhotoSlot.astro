---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { steamPaths, motif } from '@/lib/art';
interface Props {
  /** Description PRÉCISE de la photo Clean2Go à fournir (affichée en brouillon) et texte ALT une fois la photo en place. */
  caption: string;
  seed?: number;
  ratio?: 'wide' | 'tall' | 'sq' | '';
  light?: boolean;
  /** Photo réelle : import depuis src/assets/photos/… */
  src?: ImageMetadata;
  eager?: boolean;
  class?: string;
}
const { caption, seed = 1, ratio = '', light = false, src, eager = false, class: cls = '' } = Astro.props;
const showTodo = import.meta.env.DEV || import.meta.env.PUBLIC_DRAFT === '1';
const paths = steamPaths(seed);
const m = motif(seed);
const stroke = light ? '#0F1317' : '#ffffff';
---
<figure class={`ph ph--art ${ratio ? `ph--${ratio}` : ''} ${light ? 'ph--light' : ''} ${cls}`}>
  {src ? (
    <Image src={src} alt={caption} loading={eager ? 'eager' : 'lazy'} widths={[480, 800, 1200]} sizes="(max-width: 720px) 100vw, 50vw" format="webp" />
  ) : (
    <>
      <svg class="art" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <pattern id={`p-${seed}`} width="16" height="16" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path d="M0 0h16M0 0v16" stroke={stroke} stroke-width=".6" opacity=".22" />
          </pattern>
        </defs>
        {m === 'stitch' && <rect x="150" y="70" width="230" height="230" rx="18" fill={`url(#p-${seed})`} />}
        {m === 'rim' && (
          <g stroke={stroke} fill="none" opacity=".28" stroke-width="1.2">
            <circle cx="270" cy="190" r="100" /><circle cx="270" cy="190" r="70" /><circle cx="270" cy="190" r="24" />
            {[0, 1, 2, 3, 4].map((i) => <path d={`M270 190 L${270 + 100 * Math.cos((i * 72 * Math.PI) / 180)} ${190 + 100 * Math.sin((i * 72 * Math.PI) / 180)}`} />)}
          </g>
        )}
        {m === 'grid' && (
          <g stroke={stroke} opacity=".26" stroke-width="1.2">
            {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M170 ${90 + i * 26} H380`} />)}
          </g>
        )}
        {m === 'dots' && (
          <g fill={stroke} opacity=".22">
            {Array.from({ length: 6 }).flatMap((_, y) => Array.from({ length: 9 }).map((_, x) => <circle cx={150 + x * 26} cy={80 + y * 30} r="2.2" />))}
          </g>
        )}
        <g>
          {paths.map((p) => <path d={p.d} stroke={p.red ? '#E8453F' : stroke} stroke-width={p.w} opacity={p.red ? 0.75 : p.o} />)}
        </g>
      </svg>
      {showTodo && (
        <figcaption class="ph__tag"><b>PHOTO CLEAN2GO À FOURNIR</b><small>{caption}</small></figcaption>
      )}
    </>
  )}
</figure>
