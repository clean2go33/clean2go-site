---
import Icon from './Icon.astro';
import { SITE, LEGAL, ZONES, LEGAL_LINKS } from '@/config/site';
import { getServices, getCities, servicePath, cityPath } from '@/lib/content';
const services = await getServices();
const cities = [...(await getCities('metropole')).slice(0, 4), ...(await getCities('bassin')).slice(0, 4)];
const social = [
  { k: 'instagram', label: 'Instagram', url: SITE.social.instagram },
  { k: 'tiktok', label: 'TikTok', url: SITE.social.tiktok },
  { k: 'google', label: 'Google Business', url: SITE.social.googleBusiness },
].filter((s) => s.url);
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <a class="logo" href="/" aria-label="Clean2Go, solutions vapeur : accueil"><img src="/logo-light.png" alt="Clean2Go, solutions vapeur" width="720" height="299" decoding="async" /></a>
        <p style="margin-top:18px;max-width:34ch">{SITE.pitch}</p>
        <p><a href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p style="margin:0"><a class="btn btn--red btn--sm" href="/contact/#reservation">Réserver</a></p>
        {social.length > 0 && <ul style="display:flex;gap:14px;margin-top:18px">{social.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a></li>)}</ul>}
      </div>
      <div><h4>Prestations</h4><ul>{services.map((s) => <li><a href={servicePath(s.id)}>{s.data.name}</a></li>)}<li><a href="/tarifs/">Tarifs</a></li></ul></div>
      <div><h4>Zones</h4><ul>{ZONES.map((z) => <li><a href={z.href}>{z.label}</a></li>)}{cities.map((c) => <li><a href={cityPath(c.id)}>{c.data.name}</a></li>)}<li><a href="/zones-d-intervention/"><b>Toutes les zones</b></a></li></ul></div>
      <div><h4>Clean2Go</h4><ul><li><a href="/a-propos/">À propos</a></li><li><a href="/professionnels/">Professionnels</a></li><li><a href="/blog/">Conseils et blog</a></li><li><a href="/faq/">Questions fréquentes</a></li><li><a href="/contact/">Contact et réservation</a></li><li><a href="/plan-du-site/">Plan du site</a></li></ul></div>
      <div><h4>Informations légales</h4><ul>{LEGAL_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
    </div>
    <div class="ftr__bot">
      <span>© {new Date().getFullYear()} {SITE.name}, nom commercial de {LEGAL.legalName}, SAS au capital de {LEGAL.capital}, {LEGAL.rcs}.</span>
      <span>Interventions : Bordeaux Métropole, Bassin d’Arcachon, Gironde.</span>
    </div>
  </div>
</footer>
