---
import Icon from './Icon.astro';
import { SITE, NAV, ZONES } from '@/config/site';
import { getServices, getCities, servicePath, cityPath } from '@/lib/content';
const path = Astro.url.pathname;
const services = await getServices();
const zoneGroups = await Promise.all(ZONES.map(async (z) => ({ ...z, cities: await getCities(z.key) })));
const cur = (h: string) => (path === h ? 'page' : undefined);
const chev = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a class="logo" href="/" aria-label="Clean2Go, solutions vapeur : accueil"><img src="/logo.png" alt="Clean2Go, solutions vapeur" width="720" height="299" decoding="async" /></a>
    <nav class="nav" id="nav" aria-label="Navigation principale">
      <ul>
        {NAV.main.map((item) =>
          'menu' in item ? (
            <li class="has-sub" data-open="false">
              <button class="nav__btn" type="button" aria-expanded="false" aria-haspopup="true">{item.label}<Fragment set:html={chev} /></button>
              <a class="nav__alt" href={item.menu === 'services' ? '/prestations/' : '/zones-d-intervention/'} aria-current={cur(item.menu === 'services' ? '/prestations/' : '/zones-d-intervention/')}>{item.label}</a>
              {item.menu === 'services' ? (
                <div class="sub">
                  {services.map((s) => <a href={servicePath(s.id)} aria-current={cur(servicePath(s.id))}>{s.data.name}<small>{s.data.short}</small></a>)}
                  <hr class="sub__x" />
                  <a class="sub__x" href="/prestations/" aria-current={cur('/prestations/')}>Toutes les prestations</a>
                  <a class="sub__x" href="/tarifs/" aria-current={cur('/tarifs/')}>Voir les tarifs</a>
                </div>
              ) : (
                <div class="sub sub--wide">
                  {zoneGroups.map((z) => (
                    <div>
                      <p class="sub__title">{z.label}</p>
                      <a href={z.href} aria-current={cur(z.href)}><b>Page {z.label}</b></a>
                      {z.cities.map((c) => <a href={cityPath(c.id)} aria-current={cur(cityPath(c.id))}>{c.data.name}</a>)}
                    </div>
                  ))}
                  <div style="grid-column:1/-1"><hr /><a href="/zones-d-intervention/">Toutes les zones d’intervention</a></div>
                </div>
              )}
            </li>
          ) : (
            <li><a href={item.href} aria-current={cur(item.href)}>{item.label}</a></li>
          ),
        )}
      </ul>
      <div class="nav__mob">
        <a class="btn btn--dark" href={`tel:${SITE.phoneTel}`}><Icon name="phone" /> {SITE.phone}</a>
        <a class="btn btn--red" href={NAV.cta.href}>{NAV.cta.label}</a>
      </div>
    </nav>
    <div class="hdr__cta">
      <a class="tel" href={`tel:${SITE.phoneTel}`} aria-label={`Appeler Clean2Go au ${SITE.phone}`}><Icon name="phone" /><span>{SITE.phone}</span></a>
      <a class="btn btn--red btn--sm" href={NAV.cta.href}>{NAV.cta.label}</a>
    </div>
    <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu"><span></span></button>
  </div>
</header>
