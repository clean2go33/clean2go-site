---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
---
<Base title="Demande envoyée | Clean2Go" description="Votre demande a bien été transmise à Clean2Go. Nous revenons vers vous rapidement avec une proposition adaptée." noindex>
  <Section><div style="max-width:640px"><span class="eyebrow">Demande envoyée</span><h1>Merci, votre demande est bien partie.</h1><p class="lead" style="color:var(--muted)">Nous la lisons et revenons vers vous avec une proposition adaptée. Pour une demande urgente, appelez-nous.</p><div class="btns"><Button href="/">Retour à l’accueil</Button><Button href="/prestations/" variant="line" arrow={false}>Voir les prestations</Button></div></div></Section>
</Base>
