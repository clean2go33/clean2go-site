---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---
<Base title="Page introuvable | Clean2Go" description="Cette page n’existe pas ou a changé d’adresse. Retrouvez nos prestations, nos zones d’intervention ou contactez Clean2Go." noindex>
  <section class="sec notfound reveal"><div class="wrap">
    <p class="eyebrow">Erreur 404</p><h1>404</h1>
    <h2>Cette page n’existe pas, ou elle a changé d’adresse.</h2>
    <p class="lead" style="color:var(--muted)">Pas de panique : voici de quoi retrouver votre chemin.</p>
    <div class="btns"><Button href="/">Retour à l’accueil</Button><Button href="/prestations/" variant="line" arrow={false}>Nos prestations</Button><Button href="/zones-d-intervention/" variant="line" arrow={false}>Zones d’intervention</Button><Button href="/contact/#reservation" variant="line" arrow={false}>Réserver</Button></div>
  </div></section>
</Base>
