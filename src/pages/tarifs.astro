---
import { PHOTOS } from '@/data/photos';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import PriceTable from '@/components/PriceTable.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import PhotoSlot from '@/components/PhotoSlot.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbs, faqPage } from '@/lib/schema';
const crumbs = [{ label: 'Tarifs' }];
const faq = [
  { q: 'Comment le prix est-il établi ?', a: 'Il dépend de la prestation choisie (intérieur, extérieur ou les deux), de la taille du véhicule et de son état. Le devis vous donne le montant avant l’intervention : il n’y a pas de mauvaise surprise le jour J.' },
  { q: 'Qu’est-ce qui peut s’ajouter au tarif de base ?', a: 'Uniquement ce que l’état du véhicule justifie : poils d’animaux en grande quantité, salissures très importantes, traitement d’odeurs. Ces suppléments sont annoncés dans le devis, jamais ajoutés après coup.' },
  { q: 'Comment payer ?', a: 'Nous acceptons le paiement par chèque, espèces ou virement, à la fin de la prestation, une fois le résultat constaté ensemble.' },
  { q: 'Les tarifs professionnels sont-ils différents ?', a: 'Pour plusieurs véhicules ou des passages réguliers, nous établissons une proposition adaptée à votre parc. Voir la page [Professionnels](/professionnels/).' },
  { q: 'Le déplacement est-il compris ?', a: 'Les éventuels frais de déplacement, selon votre adresse, sont indiqués dans le devis.' },
];
---
<Base title="Tarifs : devis nettoyage auto à la vapeur | Clean2Go" description="Tarifs Clean2Go sur devis : nettoyage intérieur, extérieur ou complet à la vapeur, suppléments éventuels et fonctionnement du devis. Réponse sur demande." schema={[breadcrumbs(crumbs, '/tarifs/'), faqPage(faq)]}>
  <Hero eyebrow="Tarifs" h1="Un devis clair avant chaque intervention" lead="Nos tarifs sont communiqués sur devis, avant toute intervention. Voici les formules, les suppléments éventuels et la façon dont le prix est établi." crumbs={crumbs} cta={{ label: 'Réserver', href: '/contact/#devis' }} bg={PHOTOS.tapis} />
  <Section eyebrow="Les formules" title="Trois formules, selon votre besoin"><PriceTable /></Section>
  <Section variant="mist" eyebrow="Ce que le prix comprend" title="Un prix, une prestation complète">
    <div class="grid grid--3">
      <div class="card"><span class="card__ico"><Icon name="steam" /></span><h3>Le matériel</h3><p>Le matériel vapeur et les consommables nécessaires à la prestation sont à notre charge.</p></div>
      <div class="card"><span class="card__ico"><Icon name="pin" /></span><h3>Le déplacement</h3><p>Nous nous déplaçons à votre domicile ou sur votre site, à Bordeaux Métropole et sur le Bassin d’Arcachon. Les frais de déplacement sont inclus dans le devis.</p></div>
      <div class="card"><span class="card__ico"><Icon name="file" /></span><h3>Le devis</h3><p>Un devis clair avant l’intervention : prestation, véhicule, éventuels suppléments. Vous validez, nous intervenons.</p></div>
    </div>
  </Section>
  <Section eyebrow="Questions sur les prix" title="Tout savoir avant de demander un devis"><Faq items={faq} open={0} /></Section>
  <CtaBand />
</Base>
