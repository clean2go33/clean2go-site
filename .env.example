# Copier en .env pour le développement local. Ne JAMAIS committer .env.

# URL publique du site (canonical, sitemap, Open Graph). Production : https://clean2go.fr
PUBLIC_SITE_URL=https://clean2go.fr

# Formulaire de devis. Par défaut le site utilise /envoyer.php (script PHP fourni, hébergement mutualisé Hostinger).
# Sur Netlify / Cloudflare / Vercel, pointer vers un service de formulaire (Formspree, Web3Forms…) :
PUBLIC_FORM_ENDPOINT=/envoyer.php

# Mesure d'audience (OPTIONNEL). Vide = aucun script, aucun cookie, aucun bandeau de consentement.
# Si renseigné, le script ne se charge QU'APRÈS consentement via le bandeau.
PUBLIC_GA_ID=

# Vérification Google Search Console (balise meta, OPTIONNEL)
PUBLIC_GSC_VERIFICATION=

# Réseaux sociaux (OPTIONNEL : un lien n'est affiché que s'il est renseigné)
PUBLIC_INSTAGRAM_URL=
PUBLIC_TIKTOK_URL=
PUBLIC_GOOGLE_BUSINESS_URL=

# Mode tarifs si les prix ne sont pas renseignés dans src/data/tarifs.ts : "devis" affiche une page « tarif sur devis ».
PUBLIC_TARIFS_FALLBACK=devis

# Production stricte : le script de validation échoue s'il reste des [INFORMATION À CONFIRMER] (mettre 1 avant mise en ligne)
STRICT_CONFIRM=0

# Lecture dans le code (voir CLAUDE.md)
PUBLIC_DRAFT=0
PUBLIC_NOINDEX=0
